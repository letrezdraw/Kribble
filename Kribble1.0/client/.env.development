# Development environment variables
# Use empty strings to leverage Vite's proxy (configured in vite.config.ts)
# This routes API calls through the Vite dev server, avoiding CORS issues
VITE_API_URL=
VITE_SOCKET_URL=
# K2 Multiplayer engine connects directly to Kribble 1.0 server on port 3001
VITE_K2_SOCKET_URL=http://localhost:3001


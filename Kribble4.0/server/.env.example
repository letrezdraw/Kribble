# Server Environment Variables Template
# Copy this file to .env and fill in your actual values

# Node Environment (development | production)
NODE_ENV=development

# Server Port (default: 3001)
PORT=3001

# Database URL
# For local SQLite: ./data/kribble.db
# For PostgreSQL: postgresql://user:password@localhost:5432/kribble
DATABASE_URL=./data/kribble.db

# JWT Secret - Generate a strong random string
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this

# CORS Origin - Frontend URL
# For local development: http://localhost:5173
# For production: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:5173

# Optional: Enable debug logging
DEBUG=true

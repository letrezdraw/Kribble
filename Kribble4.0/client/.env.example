# ============================================
# Kribble Client - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env files to git!

# ============================================
# API Configuration
# ============================================

# API URL - Backend server URL
# Options:
#   - Leave empty for same-origin requests (when server serves the client)
#   - Set to full URL for separate development server
#   - Examples:
#     VITE_API_URL=http://localhost:3001
#     VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=

# Socket URL - WebSocket server URL
# Options:
#   - Leave empty for same-origin (auto-detects from current host)
#   - Set to full URL for separate development server
#   - Examples:
#     VITE_SOCKET_URL=http://localhost:3001
#     VITE_SOCKET_URL=https://your-api.onrender.com
VITE_SOCKET_URL=

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable debug logging
# VITE_DEBUG=true

# Enable mock API for testing
# VITE_MOCK_API=false

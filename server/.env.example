# Server Configuration
NODE_ENV=development
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Configuration
# For development: leave empty to use SQLite
# For production: set DATABASE_URL to use PostgreSQL
# Example: DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=

# Render will automatically set this in production
# RENDER=true

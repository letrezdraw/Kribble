{
  "name": "kribble",
  "version": "1.0.0",
  "description": "Multiplayer Drawing & Guessing Game",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build:shared && npm run build --workspaces",
    "build:shared": "cd shared && npm run build",
    "build:server": "npm run build:shared && cd server && npm run build",
    "build:client": "npm run build:shared && cd client && npm run build",
    "start": "cd server && npm start",

    "install:all": "npm install",
    "setup": "node scripts/setup-local-env.js",
    "tunnel": "scripts\\mobile-tunnel.bat",

    "tunnel:ps": "powershell -ExecutionPolicy Bypass -File scripts\\mobile-tunnel.ps1",
    "tunnel:ngrok": "ngrok http 3001",
    "ip": "powershell -Command \"(Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.254.*' } | Select-Object -First 1).IPAddress\""
  },

  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

# Server Local Development Environment Variables

# Node Environment
NODE_ENV=development

# Server Port
PORT=3001

# Database URL - SQLite for local development
DATABASE_URL=./data/kribble.db

# JWT Secret - Generate a random string for local use
JWT_SECRET=your-local-jwt-secret-key-change-this-in-production

# CORS Origin - Allow local Vite dev server
CORS_ORIGIN=http://localhost:5173

# Optional: Enable debug logging
DEBUG=true

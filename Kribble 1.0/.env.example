# ============================================
# Kribble - Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env files to git!

# ============================================
# General
# ============================================
NODE_ENV=development

# ============================================
# Server Configuration
# ============================================
# Server port (default: 3001)
PORT=3001

# Database URL (PostgreSQL)
# Format: postgresql://username:password@host:port/database
# For local development, you can use SQLite by leaving this empty
DATABASE_URL=

# JWT Secret for authentication
# Generate a strong random string for production
JWT_SECRET=your-jwt-secret-key-here

# CORS Origin for production
# In development, CORS is automatically configured for localhost
# In production, set this to your frontend URL
# CORS_ORIGIN=https://your-app.onrender.com

# ============================================
# Client Configuration (Vite)
# ============================================
# API URL - leave empty for same-origin (when using proxy)
# Or set to your server URL for separate development
# VITE_API_URL=http://localhost:3001

# Socket URL - leave empty for same-origin
# Or set to your server URL for separate development
# VITE_SOCKET_URL=http://localhost:3001

# Kribble Client Environment Variables
# Copy this file to .env.development for local development

# API URL - Backend server URL
# For local development with server on port 3000:
VITE_API_URL=http://localhost:3000

# Socket.io URL - WebSocket server URL  
# For local development (usually same as API):
VITE_SOCKET_URL=http://localhost:3000

# For production builds, these should be empty strings (same-origin)
# VITE_API_URL=
# VITE_SOCKET_URL=

# ============================================
# Kribble Client - Production Environment
# ============================================
# This file is committed to git with safe defaults
# Actual production values are set in deployment platform (Render/Railway)

# In production, the API and Socket URLs should be empty
# because the Express server serves the client (same-origin)
VITE_API_URL=
VITE_SOCKET_URL=

# Debug mode (disabled in production)
VITE_DEBUG=false

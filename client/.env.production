# Production Environment Variables
# These settings are for production builds (Render, Railway, etc.)

# API URL - Empty string for same-origin requests
# When the Express server serves the client, API calls go to the same domain
VITE_API_URL=

# Socket.io URL - Empty string for same-origin
# Socket.io will connect to the same domain
VITE_SOCKET_URL=

# Debug mode - Disabled in production
VITE_DEBUG=false

# ============================================
# Kribble Client - Development Environment
# ============================================
# This file is committed to git with safe defaults
# For local overrides, create a .env.local file (not committed)

# API URL - Set to your local server port
# Leave empty if using Vite proxy (recommended)
# Or set to http://localhost:3001 if running server separately
VITE_API_URL=

# Socket URL - Same as API URL
# Leave empty for same-origin
VITE_SOCKET_URL=

# Debug mode
VITE_DEBUG=true

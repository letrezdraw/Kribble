# Local Development Environment Variables
# These settings are for running the app locally on your machine

# API URL - Point to your local server
# Use http://localhost:3001 if running server separately
# Use empty string if using Vite's proxy (configured in vite.config.ts)
VITE_API_URL=http://localhost:3001

# Socket.io URL - Usually same as API URL
# Can be empty string for same-origin when using proxy
VITE_SOCKET_URL=http://localhost:3001

# Optional: Enable debug logging
VITE_DEBUG=true
